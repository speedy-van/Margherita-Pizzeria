{
  "name": "margherita-admin-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "TEMPORARY Expo/React Native debug harness mirroring the native Kotlin admin app. Runs on Metro port 8081. Used only for fast local iteration; the native Kotlin app in apps/admin-android remains the production target.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --port 8081",
    "start:lan": "expo start --port 8081 --lan",
    "start:tunnel": "expo start --port 8081 --tunnel",
    "android": "expo start --port 8081 --android",
    "web": "expo start --port 8081 --web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "^56.0.12",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-constants": "~17.0.8",
    "expo-image-picker": "~16.0.6",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-dom": "^18.3.1",
    "react-native": "^0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "^0.19.13"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "typescript": "~5.3.3"
  }
}
