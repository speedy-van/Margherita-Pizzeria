{
  "expo": {
    "name": "Margherita Admin",
    "slug": "margherita-pizzaa",
    "owner": "ahmadawadalwakai",
    "version": "1.0",
    "icon": "./assets/icons/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "margherita-admin",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "android": {
      "package": "uk.margheritapizzeria.admin",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "ios": {
      "bundleIdentifier": "uk.margheritapizzeria.admin",
      "icon": "./assets/icons/icon.png",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Staff can take restaurant, menu and website photos for Margherita Pizzeria.",
        "NSPhotoLibraryUsageDescription": "Staff can choose restaurant, menu and website photos for Margherita Pizzeria."
      },
      "buildNumber": "20"
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "MARGHERITA_PROD_URL": "https://www.margheritapizza.uk",
      "eas": {
        "projectId": "906a4b60-7821-4e06-97ee-dd9a1f0ac174"
      }
    },
    "plugins": [
      "expo-audio",
      "expo-font",
      "expo-asset",
      "expo-sharing"
    ]
  }
}
