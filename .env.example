# Public site URL (no trailing slash). Defaults to http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=https://margheritapizza.uk

# Neon PostgreSQL connection string (use the pooled connection string from Neon).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Mapbox public access token (used by future delivery map UI).
NEXT_PUBLIC_MAPBOX_TOKEN=

# NextAuth.js v5. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Optional. Where NextAuth thinks the site lives. Usually inferred at runtime,
# but set this if you run the admin behind a reverse proxy.
# NEXTAUTH_URL=http://localhost:3000

# Optional admin seed. ONLY read by `npm run db:seed`. Never required at runtime.
# If both are present, the seed creates a single admin user idempotently.
# Password must be at least 10 characters and contain a letter and a number.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Resend (planned). API key + verified sender address.
AUTH_RESEND_KEY=
RESEND_FROM_EMAIL=orders@margheritapizza.uk

# Optional: inbox that receives messages from the /contact form.
# Resolution order: CONTACT_TO_EMAIL → ADMIN_NOTIFICATION_EMAIL → RESEND_FROM_EMAIL (dev fallback).
CONTACT_TO_EMAIL=

# Optional: inbox that receives operational admin notifications
# (new orders, new booking requests). Safe to leave empty in development.
ADMIN_NOTIFICATION_EMAIL=

# Stripe (planned). Secret + webhook signing secret + publishable key.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Firebase Cloud Messaging service account (planned, for kitchen device alerts).
# OPTIONAL until push notifications are actively wired up. The app builds and
# runs without these; helpers must check `hasFcmConfig` (lib/env.ts) and skip
# safely when unset. Required once the FCM send path is enabled in production.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# The private key must keep its newlines. When pasting into a single line, escape them as \n.
FCM_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Optional: Google Analytics 4 + Google Ads (Phase 7 landing-page tracking).
# All four are OPTIONAL. Landing pages must build and run without them.
# Do NOT put secrets here — these are public client-side IDs only.
# ---------------------------------------------------------------------------

# GA4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Ads account ID, e.g. AW-1234567890
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Conversion labels (the bit after the slash in AW-XXXX/XYZ).
NEXT_PUBLIC_GOOGLE_ADS_ORDER_CONVERSION_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_COLLECTION_CONVERSION_LABEL=

